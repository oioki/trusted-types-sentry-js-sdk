{
  "name": "trusted-types-sentry-js-sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Minimal React app with a Trusted Types CSP, showing the violations raised by the Sentry JavaScript SDK",
  "scripts": {
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:enforce": "TT_MODE=enforce vite preview --port 4173 --strictPort",
    "check": "node scripts/check.mjs",
    "check:enforce": "TT_MODE=enforce node scripts/check.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
